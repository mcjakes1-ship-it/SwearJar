{
  "name": "MixAMonster",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Config": { "$path": "src/ReplicatedStorage/Config" },
      "Shared": { "$path": "src/ReplicatedStorage/Shared" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$path": "src/ServerStorage"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "StreamingEnabled": true, "FilteringEnabled": true }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.42, 0.44, 0.52],
        "OutdoorAmbient": [0.55, 0.58, 0.66],
        "Brightness": 2.4,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.3
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
